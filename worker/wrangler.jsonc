{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiffi-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://hiffi.com",
    "GO_BACKEND_URL": "https://api.hiffi.com"
  }
}
