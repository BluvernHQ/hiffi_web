# Canonical site URL for SEO (Open Graph, sitemap, JSON-LD). No trailing slash.
# Must match the host Google crawls (prod nginx serves www; apex 301s here).
NEXT_PUBLIC_SITE_URL=https://www.hiffi.com

# Optional: Organization JSON-LD (schema.org) — brand name, logo, social profiles, address, geo.
NEXT_PUBLIC_ORG_NAME=Hiffi
NEXT_PUBLIC_ORG_LEGAL_NAME=
NEXT_PUBLIC_ORG_LOGO=/icon.svg
# Space- or comma-separated profile URLs (sameAs)
NEXT_PUBLIC_ORG_SAME_AS=https://www.instagram.com/officialhiffi/,https://x.com/officialhiffi,https://www.youtube.com/@officialhiffi,https://apps.apple.com/us/app/hiffi/id6759672725,https://play.google.com/store/apps/details?id=com.hiffi.app
NEXT_PUBLIC_ORG_ADDRESS_STREET=
NEXT_PUBLIC_ORG_ADDRESS_LOCALITY=
NEXT_PUBLIC_ORG_ADDRESS_REGION=
NEXT_PUBLIC_ORG_ADDRESS_POSTAL_CODE=
# ISO 3166-1 alpha-2 (e.g. US, IN)
NEXT_PUBLIC_ORG_ADDRESS_COUNTRY=
NEXT_PUBLIC_ORG_GEO_LAT=
NEXT_PUBLIC_ORG_GEO_LNG=

# Required in production for rich profile meta/schema (name, bio, avatar, Person sameAs).
# Server-only — never expose as NEXT_PUBLIC_*. Set in your hosting provider's secrets.
# Without this, profile pages still render but OG/JSON-LD fall back to @handle only.
HIFFI_SERVER_READ_BEARER=

# Sitemap tuning (optional). Defaults: max 50,000 videos, 10,000 per chunk when split.
# SITEMAP_MAX_VIDEOS=50000
# SITEMAP_VIDEO_CHUNK_SIZE=10000

# Environment: dev | beta | prod (defaults to beta). Restart `npm run dev` after changing.
NEXT_PUBLIC_ENV=beta

# Optional overrides (take precedence over NEXT_PUBLIC_ENV defaults):
# NEXT_PUBLIC_API_URL=https://api.dev.hiffi.com
# NEXT_PUBLIC_WORKERS_URL=https://dev.hiffi.workers.dev
# Server-side Go calls (login bridge). On the same VPS: http://127.0.0.1:5001
# HIFFI_API_INTERNAL_URL=http://127.0.0.1:5001

# Analytics Configuration
# Microsoft Clarity Analytics ID
NEXT_PUBLIC_CLARITY_ID=your_clarity_id_here

# Google Analytics ID
NEXT_PUBLIC_GA_ID=your_ga_id_here

# Umami (e.g. analytics.superlabs.co) website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id_here

# Optional: collect Core Web Vitals in Umami (adds `data-performance="true"`).
# Disable with "false" / "0".
NEXT_PUBLIC_UMAMI_PERFORMANCE=true

# Optional: enable Umami session replay (recorder.js). Disable with "false" / "0".
NEXT_PUBLIC_UMAMI_REPLAY_ENABLED=true

# First-party HifiAnalytics (tracker.js at /proxy/tracker.js). Defaults to on in `next dev` (localhost).
# Set to true/1 to force on in production builds; false/0 to disable locally.
# NEXT_PUBLIC_API_ANALYTICS=true

# Ingest key expected by analytics API for event writes / admin query proxies.
# Prefer server-only ANALYTICS_INGEST_KEY for admin session queries; public key is used by tracker.js.
# ANALYTICS_INGEST_KEY=
NEXT_PUBLIC_ANALYTICS_INGEST_KEY=

# Creator onboarding (welcome email CTAs)
# Optional override for Calendly walkthrough link (defaults to https://calendly.com/hiffiapps/30min)
NEXT_PUBLIC_CALENDLY_WALKTHROUGH_URL=

# Site key is public; secret must stay server-only (verified on Next.js BFF + Hiffi API).
# Turnstile is off during `next dev` (including localhost). Set
# NEXT_PUBLIC_TURNSTILE_FORCE=true to test Turnstile locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_FORCE=true

# Artist claim: collect a password, socials and profile fields, and sign the artist in on submit.
# Server-only (read at runtime by the claim page and /api/inventory/claims). Needs the API build
# with claim account setup + instant login.
INVENTORY_CLAIM_ACCOUNT_SETUP=true

# Better Auth
BETTER_AUTH_SECRET=generate_a_32_plus_char_secret
BETTER_AUTH_URL=https://dev.hiffi.com
# Same Postgres database as the Go backend
DATABASE_URL=postgres://user:password@host:5432/hiffi
# Must match AUTH_BRIDGE_SECRET in the Go backend env
AUTH_BRIDGE_SECRET=generate_a_shared_secret
# Optional: Go API address for server-side auth calls (bypasses Cloudflare), e.g. http://127.0.0.1:5001
HIFFI_API_INTERNAL_URL=
# Optional Cloudflare Worker gateway. Do not reuse AUTH_BRIDGE_SECRET.
# GATEWAY_SECRET is set on the Worker and the Go origin only.

# Optional social logins (also switched on/off in the admin dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

